rules_version = '2';

// =============================================================================
// FIRESTORE SECURITY RULES
// -----------------------------------------------------------------------------
// Apply this: Firebase Console → Firestore Database → Rules tab → paste this
// entire file in, replacing what's there → Publish.
//
// Plain-language summary:
// - Anyone visiting the site can READ the public content collections listed
//   below (that's needed for the pages to display at all).
// - Only you (signed in as adnansite01@gmail.com) can WRITE/edit/delete any
//   of it — done through admin.html.
// - Anyone can SUBMIT a contact message or a newsletter subscription, but
//   only you can read or manage them afterwards.
// - Anything not explicitly listed is denied by default.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "adnansite01@gmail.com";
    }

    // ---- Every public content collection: readable by anyone, editable
    //      only by the admin. Add a new collection name to this list if you
    //      add a brand-new "list" section in js/admin-schema.js later.
    match /{collectionId}/{docId} {
      allow read: if collectionId in [
        "content", "aboutFacts", "experience", "skills", "services",
        "pricing", "projects", "testimonials", "posts", "shop",
        "courses", "faq", "social", "pages", "blocks", "navLinks"
      ];
      allow write: if isAdmin();
    }

    // ---- Contact messages: public can create, only admin can read/manage
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Newsletter subscribers: public can create, only admin can read/manage
    match /subscribers/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // ---- Everything else: denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
